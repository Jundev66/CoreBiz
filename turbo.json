{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "DATA_DRIVER",
    "ALLOW_MEMORY_DRIVER",
    "DATABASE_URL",
    "DIRECT_URL",
    "DATABASE_MAX_CONNECTIONS",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SITE_URL",
    "SIGNUP_ENABLED",
    "DEMO_ENABLED",
    "REQUEST_HASH_SECRET",
    "CRON_SECRET",
    "DEMO_TTL_HOURS",
    "DEMO_MAX_CONCURRENT",
    "DEMO_MAX_PER_HOUR",
    "PORT",
    "SUPABASE_URL",
    "API_BASE_URL",
    "INTERNAL_API_SECRET",
    "LOGIN_MAX_PER_MINUTE",
    "SUPABASE_ANON_KEY",
    "E2E_DRIVER"
  ],
  "globalDependencies": ["tsconfig.base.json", ".env.example", ".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": false
    }
  }
}
