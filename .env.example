# ─────────────────────────────────────────────────────────────────────────────
# CoreBiz — plantilla de variables de entorno
#
# Copia este archivo a `.env` EN LA RAIZ del repositorio y rellena los valores. Esta en
# .gitignore; nunca se commitea.
#
# La raiz, y no `apps/web/.env.local`: ese fichero solo lo lee Next, y la API no lee
# ninguno por su cuenta. Tener la configuracion en dos sitios es lo que hacia que
# `pnpm dev` contra Postgres no arrancase solo, y que faltando `API_BASE_URL` la web
# creyese que la API estaba dormida. Ahora los dos procesos leen este mismo fichero.
#
# Since the delivery layer became a NestJS API there are TWO Vercel projects, and the
# variables are split between them. The tag says where each one lives in production
# (docs/DEPLOY.md, docs/adr/011-api-en-vercel.md):
#
#   [api]  -> corebiz-api. Everything that talks to Postgres or applies a business rule.
#   [web]  -> corebiz-web. What the browser and the sign-in flow need.
#   [dos]  -> both, with the SAME value.
#
# En local un solo `.env` en la raiz sirve para ambas.
#
# Si solo quieres ver la aplicacion funcionando, no necesitas nada de esto:
#   pnpm dev:nodb
# arranca con adaptadores en memoria, sin base de datos ni credenciales.
# ─────────────────────────────────────────────────────────────────────────────

# ── Driver de datos ──────────────────────────────────────────────────────────
# [dos] `postgres` (por defecto) | `memory` (sin base de datos, datos precargados)
DATA_DRIVER=postgres

# Publishes the OpenAPI document at `/docs` and `/docs-json`. Off by default, and it has to
# be asked for by name: an open OpenAPI document for an ERP is a free map of its entire
# write surface, and that route is permanently excluded from authentication.
#
# It used to be decided by `NODE_ENV`, which defaults to `development` — so a deployment
# that forgot that variable published the whole API without anything failing. Set it to
# `true` locally to see the API at a glance; never in a deployment.
DOCS_ENABLED=false

# ── La API ───────────────────────────────────────────────────────────────────
# [web] Donde vive la API. En local, el puerto en el que arranca `pnpm dev:api`.
API_BASE_URL=http://127.0.0.1:3001

# [api] Port for the long-lived process (`pnpm dev:api`). Unused on Vercel.
PORT=3001

# [dos] Secreto compartido para los endpoints internos —el limitador de intentos y la
# purga—, que no llevan sesion de usuario porque se invocan antes de que exista una.
# Sin el, /internal/* responde 404 en lugar de abrirse.
#   openssl rand -base64 32
INTERNAL_API_SECRET=

# ── Base de datos ── [api] ───────────────────────────────────────────────────
# Solo la API habla con Postgres. Que apps/web no tenga acceso a la base es la prueba
# observable de la separacion; ver docs/adr/009-api-dedicada-en-nestjs.md.
#
# Pooler Supavisor en modo transaccion (puerto 6543).
# IMPORTANTE: este modo no admite prepared statements; el cliente los desactiva.
DATABASE_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres

# Pool size PER PROCESS. Locally the API is one long-lived process and ten is fine. On
# Vercel use 3: with Fluid compute one instance serves concurrent requests (one connection
# would queue them) and there can be several instances (ten each would exhaust the free
# pooler).
DATABASE_MAX_CONNECTIONS=10

# [api] Supabase's public root CA (PEM), so TLS to the pooler is VERIFIED. Not a secret:
# download it from Project Settings -> Database -> SSL Configuration. Without it the API
# fails with SELF_SIGNED_CERT_IN_CHAIN; never "fix" that by disabling verification.
# DATABASE_CA_CERT=

# Conexion DIRECTA (puerto 5432). Solo para migraciones y para `pnpm db:pull`:
# introspeccionar a traves del pooler da resultados incompletos.
# El pooler en modo transaccion no soporta las sentencias multiples de una migracion.
DIRECT_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Supabase ─────────────────────────────────────────────────────────────────
# [web] Los usa el flujo de acceso, que sigue viviendo en Next.
NEXT_PUBLIC_SUPABASE_URL=https://PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [api] The same origin, WITHOUT the `NEXT_PUBLIC_` prefix: the API has no browser and the
# prefix only confuses. It verifies token signatures against the project's JWKS, without a
# network round trip per request.
#
# REQUIRES ASYMMETRIC signing keys (the default for new projects). With the shared HS256
# secret the API would need a key able to ISSUE tokens, not just verify them, and that is
# worse than the round trip.
SUPABASE_URL=https://PROYECTO.supabase.co

# [api] Solo para el test de aislamiento entre empresas, que necesita autenticarse
# contra la base LOCAL para comprobar que dos empresas no se ven entre si. Tiene valor
# por defecto —la clave publica que imprime `supabase start`— asi que en local no hace
# falta ponerla. En produccion no se usa para nada.
# SUPABASE_ANON_KEY=

# [e2e] `memory` (por defecto) o `postgres`. Elige contra que adaptador corre la suite
# de Playwright. Los scripts `test:*:pg` ya la ponen ellos; esta aqui para quien quiera
# lanzar Playwright a mano.
# E2E_DRIVER=memory

# Origen publico de la aplicacion. Lo usa el enlace del correo de recuperacion
# cuando la peticion no trae cabecera `Origin` — sin el, el enlace apunta a la
# cadena vacia y quien olvido su contrasena recibe un correo inservible.
NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app

# NO hay `SUPABASE_SERVICE_ROLE_KEY`, y es una decision, no un olvido. Esa clave
# bypasea Row Level Security por completo, y todo lo que la necesitaria —crear una
# empresa, aceptar una invitacion, provisionar una demostracion— entra por funciones
# `SECURITY DEFINER` acotadas, revocadas de `public`, que hacen exactamente una cosa
# cada una. Una llave maestra guardada por si acaso es una llave maestra que se acaba
# filtrando. Ver docs/adr/005-aislamiento-multi-tenant.md.

# ── Secretos de la aplicacion ────────────────────────────────────────────────
# Sal con la que se hashea la IP en el limitador de intentos. Sin ella el hash se
# puede deshacer: el espacio de IPv4 se recorre entero en minutos, y la tabla pasaria
# de guardar un rastro anonimo a guardar direcciones.
#   openssl rand -base64 32
#
# [web] Se hashea DONDE la IP es de fiar: la cabecera `x-forwarded-for` la pone Vercel
# y no el cliente. El contador vive en la API, pero solo recibe el hash.
REQUEST_HASH_SECRET=

# [web] Autentica el cron de Vercel. Se compara en tiempo constante. Es distinto de
# INTERNAL_API_SECRET a proposito: este lo conoce la plataforma, aquel solo los dos
# servicios.
CRON_SECRET=

# ── Alta de cuentas ──────────────────────────────────────────────────────────
# [dos] Con `false`, nadie puede crear una cuenta ni una empresa: la pantalla de
# registro explica que esta cerrado y ofrece la demostracion, y el endpoint de la API
# deja de existir. Aceptar invitaciones NO se ve afectado — quien fue invitado a una
# empresa que ya existe tiene que poder entrar.
#
# Es un interruptor, no un borrado: el flujo de alta sigue entero y probado. Se cierra
# donde el sistema se enseña, porque una cuenta creada por curiosidad es un negocio
# vacio que nadie va a volver a mirar.
SIGNUP_ENABLED=true

# ── Sandbox demo ─────────────────────────────────────────────────────────────
# [dos] Con `false`, /demo deja de entregar credenciales y redirige a /login. Es el
# interruptor que convierte esto en un SaaS normal el dia que deje de ser una
# demostracion. La interfaz lo usa para no pintar la puerta y la API para que el
# endpoint no exista, en lugar de existir y negarse.
DEMO_ENABLED=true

# [api] Los limites viven donde se aplican: los aprovisiona la API.
DEMO_TTL_HOURS=24
DEMO_MAX_CONCURRENT=50
# Sandbox COPIES per origin per hour (an account plus a full copy of the demo database each).
# Counted from real copies, not clicks. Three, so an office behind one public address is not
# locked out; past it the visitor still gets in, read-only.
DEMO_MAX_PER_HOUR=3

# Sandbox copies per hour across ALL origins, so rotating addresses cannot farm copies.
DEMO_MAX_SANDBOXES_PER_HOUR=30

# Read-only demo seats per hour once sandbox capacity is exhausted. Past it, /demo says
# "unavailable" instead of creating accounts without limit.
DEMO_MAX_READONLY_PER_HOUR=60

# Writes per verified user per hour through the API. Slows a script filling the
# database; far above what a person does at a counter.
API_WRITES_PER_HOUR=600

# [web] Intentos de acceso por minuto y origen. El valor por defecto —8— es el de
# produccion; solo se sube para la suite E2E, que entra decenas de veces desde la
# misma maquina. Vive en la web porque el acceso lo gestiona ella, contra Supabase Auth;
# lo unico que cruza a la API es el contador.
LOGIN_MAX_PER_MINUTE=8

# ── Entrar solo en local ─────────────────────────────────────────────────────
# [web] Con `true`, abrir el sistema en desarrollo deja dentro con la cuenta sembrada
# sin pasar por el formulario de acceso. Es para que quien clone el repositorio vea el
# sistema y no una pantalla pidiendole credenciales que aun no tiene.
#
# En produccion NO se aplica, y no por esta variable: `autoLoginConfig.enabled()`
# comprueba primero `NODE_ENV`. Alli la puerta es /demo, que entrega a cada visitante
# su propia copia con credenciales desechables. Si todos entraran con la misma cuenta,
# todos escribirian sobre la MISMA empresa — que ademas es la plantilla que se clona.
DEMO_AUTO_LOGIN=false
DEMO_AUTO_LOGIN_EMAIL=demo@corebiz.local
DEMO_AUTO_LOGIN_PASSWORD=corebiz-demo
