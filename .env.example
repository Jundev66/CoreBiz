# ─────────────────────────────────────────────────────────────────────────────
# CoreBiz — plantilla de variables de entorno
#
# Copia este archivo a `.env.local` y rellena los valores. NUNCA commitees `.env.local`.
# Los valores de produccion viven solo en Vercel Environment Variables.
#
# Si solo quieres ver la aplicacion funcionando, no necesitas nada de esto:
#   pnpm dev:nodb
# arranca con adaptadores en memoria, sin base de datos ni credenciales.
# ─────────────────────────────────────────────────────────────────────────────

# ── Driver de datos ──────────────────────────────────────────────────────────
# `postgres` (por defecto) | `memory` (sin base de datos, datos de ejemplo precargados)
DATA_DRIVER=postgres

# ── Base de datos ────────────────────────────────────────────────────────────
# Pooler Supavisor en modo transaccion (puerto 6543). Es el que usa la aplicacion.
# IMPORTANTE: este modo no admite prepared statements; el cliente los desactiva.
DATABASE_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres

# Conexion DIRECTA (puerto 5432). Solo para migraciones y drizzle-kit.
# El pooler en modo transaccion no soporta las sentencias multiples de una migracion.
DIRECT_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origen publico de la aplicacion. Lo usa el enlace del correo de recuperacion
# cuando la peticion no trae cabecera `Origin` — sin el, el enlace apunta a la
# cadena vacia y quien olvido su contrasena recibe un correo inservible.
NEXT_PUBLIC_SITE_URL=https://corebiz.vercel.app

# ⚠️ BYPASSEA ROW LEVEL SECURITY POR COMPLETO.
# Solo la usan tres consumidores autorizados: la provision del sandbox demo, los
# endpoints de cron y los scripts de seed. Nunca en el camino de un request de usuario,
# nunca cerca del cliente. Ver docs/adr/005-aislamiento-multi-tenant.md.
SUPABASE_SERVICE_ROLE_KEY=

# ── Secretos de la aplicacion ────────────────────────────────────────────────
# Firma la cookie de sesion del sandbox demo. Minimo 32 caracteres aleatorios.
#   openssl rand -base64 32
DEMO_COOKIE_SECRET=

# Autentica los endpoints internos de cron. Se compara en tiempo constante.
CRON_SECRET=

# ── Sandbox demo ─────────────────────────────────────────────────────────────
# Con `false`, la aplicacion EXIGE sesion: sin ella redirige a /login en vez de
# servir el tenant publico de demostracion. Es el interruptor que convierte esto
# en un SaaS normal el dia que deje de ser una demostracion.
DEMO_ENABLED=true
DEMO_TTL_HOURS=24
DEMO_MAX_CONCURRENT=50
# Turnstile de Cloudflare (gratuito, invisible). Se deja apagado hasta que haga falta.
DEMO_TURNSTILE_ENABLED=false
DEMO_TURNSTILE_SECRET=

# ── Observabilidad (opcional) ────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
