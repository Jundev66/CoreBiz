# ─────────────────────────────────────────────────────────────────────────────
# CoreBiz — plantilla de variables de entorno
#
# Copia este archivo a `.env.local` y rellena los valores. NUNCA commitees `.env.local`.
#
# Desde que la capa de entrega es una API en NestJS hay DOS despliegues, y las variables
# se reparten entre ellos. La columna dice donde vive cada una en produccion:
#
#   [api]  -> Render. Todo lo que habla con Postgres o aplica una regla de negocio.
#   [web]  -> Vercel. Lo que necesita el navegador y el flujo de acceso.
#   [dos]  -> las dos, con el MISMO valor.
#
# En local un solo `.env.local` sirve para ambas.
#
# Si solo quieres ver la aplicacion funcionando, no necesitas nada de esto:
#   pnpm dev:nodb
# arranca con adaptadores en memoria, sin base de datos ni credenciales.
# ─────────────────────────────────────────────────────────────────────────────

# ── Driver de datos ──────────────────────────────────────────────────────────
# [dos] `postgres` (por defecto) | `memory` (sin base de datos, datos precargados)
DATA_DRIVER=postgres

# ── La API ───────────────────────────────────────────────────────────────────
# [web] Donde vive la API. En local, el puerto en el que arranca `pnpm dev:api`.
API_BASE_URL=http://127.0.0.1:3001

# [api] Puerto en el que escucha. Render lo inyecta y espera que se obedezca.
PORT=3001

# [dos] Secreto compartido para los endpoints internos —el limitador de intentos y la
# purga—, que no llevan sesion de usuario porque se invocan antes de que exista una.
# Sin el, /internal/* responde 404 en lugar de abrirse.
#   openssl rand -base64 32
INTERNAL_API_SECRET=

# ── Base de datos ── [api] ───────────────────────────────────────────────────
# Solo la API habla con Postgres. Que apps/web no tenga acceso a la base es la prueba
# observable de la separacion; ver docs/adr/009-api-dedicada-en-nestjs.md.
#
# Pooler Supavisor en modo transaccion (puerto 6543).
# IMPORTANTE: este modo no admite prepared statements; el cliente los desactiva.
DATABASE_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres

# Tamano del pool. La API es un proceso de LARGA VIDA en Render, no una funcion
# serverless: con el pool en uno, cada transaccion retiene la unica conexion mientras
# dura y todo lo demas espera en fila. Diez es un valor razonable para el plan gratuito.
DATABASE_MAX_CONNECTIONS=10

# Conexion DIRECTA (puerto 5432). Solo para migraciones y drizzle-kit.
# El pooler en modo transaccion no soporta las sentencias multiples de una migracion.
DIRECT_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Supabase ─────────────────────────────────────────────────────────────────
# [web] Los usa el flujo de acceso, que sigue viviendo en Next.
NEXT_PUBLIC_SUPABASE_URL=https://PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [api] El mismo origen, SIN el prefijo `NEXT_PUBLIC_`: en Render no hay navegador y
# arrastrar ese prefijo solo confunde. La API lo usa para verificar la firma de los
# tokens contra el JWKS del proyecto, sin un viaje de red por peticion.
#
# REQUIERE que el proyecto use claves de firma ASIMETRICAS (lo son por defecto en los
# proyectos nuevos). Con el secreto HS256 compartido habria que poner en Render una
# clave capaz de EMITIR tokens, no solo de verificarlos, y eso es peor que el viaje.
SUPABASE_URL=https://PROYECTO.supabase.co

# Origen publico de la aplicacion. Lo usa el enlace del correo de recuperacion
# cuando la peticion no trae cabecera `Origin` — sin el, el enlace apunta a la
# cadena vacia y quien olvido su contrasena recibe un correo inservible.
NEXT_PUBLIC_SITE_URL=https://corebiz.vercel.app

# NO hay `SUPABASE_SERVICE_ROLE_KEY`, y es una decision, no un olvido. Esa clave
# bypasea Row Level Security por completo, y todo lo que la necesitaria —crear una
# empresa, aceptar una invitacion, provisionar una demostracion— entra por funciones
# `SECURITY DEFINER` acotadas, revocadas de `public`, que hacen exactamente una cosa
# cada una. Una llave maestra guardada por si acaso es una llave maestra que se acaba
# filtrando. Ver docs/adr/005-aislamiento-multi-tenant.md.

# ── Secretos de la aplicacion ────────────────────────────────────────────────
# Sal con la que se hashea la IP en el limitador de intentos. Sin ella el hash se
# puede deshacer: el espacio de IPv4 se recorre entero en minutos, y la tabla pasaria
# de guardar un rastro anonimo a guardar direcciones.
#   openssl rand -base64 32
#
# [web] Se hashea DONDE la IP es de fiar: la cabecera `x-forwarded-for` la pone Vercel
# y no el cliente. El contador vive en la API, pero solo recibe el hash.
REQUEST_HASH_SECRET=

# [web] Autentica el cron de Vercel. Se compara en tiempo constante. Es distinto de
# INTERNAL_API_SECRET a proposito: este lo conoce la plataforma, aquel solo los dos
# servicios.
CRON_SECRET=

# ── Sandbox demo ── [api] ────────────────────────────────────────────────────
# Con `false`, /demo deja de entregar credenciales y redirige a /login. Es el
# interruptor que convierte esto en un SaaS normal el dia que deje de ser una
# demostracion. El resto del sistema no cambia: ya exige sesion siempre.
DEMO_ENABLED=true
DEMO_TTL_HOURS=24
DEMO_MAX_CONCURRENT=50
# Visitantes por origen y hora. Cada uno cuesta una cuenta nueva y una copia
# entera de la base de demostracion, asi que uno es lo razonable en produccion.
DEMO_MAX_PER_HOUR=1

# Intentos de acceso por minuto y origen. El valor por defecto —8— es el de
# produccion; solo se sube para la suite E2E, que entra decenas de veces desde la
# misma maquina.
LOGIN_MAX_PER_MINUTE=8
