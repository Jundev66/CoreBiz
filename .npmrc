# Estricto a proposito: un paquete solo puede importar lo que declaro en su package.json.
# Es lo que impide que packages/domain importe drizzle "por accidente" y mantiene
# honesta la arquitectura hexagonal a nivel de resolucion de modulos, no solo de lint.
hoist=false
strict-peer-dependencies=false
auto-install-peers=true
resolution-mode=highest
