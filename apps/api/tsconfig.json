{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "isolatedModules": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "useDefineForClassFields": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "../..",
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@corebiz/domain": ["../../packages/domain/src/index"],
      "@corebiz/domain/*": ["../../packages/domain/src/*/index"],
      "@corebiz/application": ["../../packages/application/src/index"],
      "@corebiz/application/ports": ["../../packages/application/src/ports/index"],
      "@corebiz/contracts": ["../../packages/contracts/src/index"],
      "@corebiz/db": ["../../packages/db/src/index"],
      "@corebiz/db/schema": ["../../packages/db/src/schema/index"],
      "@corebiz/infrastructure": ["../../packages/infrastructure/src/index"],
      // Va en `paths` como los demas: el cliente de Prisma 7 es TypeScript en crudo, asi
      // que `tsc` lo compila a `dist` y `tsc-alias` reescribe el require. Si se dejase
      // fuera, Node intentaria cargar el `.ts` original en produccion.
      "@corebiz/prisma-client": ["../../packages/prisma-client/generated/client"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
