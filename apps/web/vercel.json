{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "app/demo/page.tsx": {
      "maxDuration": 60
    },
    "app/api/cron/purge/route.ts": {
      "maxDuration": 60
    }
  }
}
