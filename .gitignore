# dependencias
node_modules/
.pnpm-store/

# builds
.next/
out/
dist/
build/
*.tsbuildinfo

# entorno  — NUNCA commitear secretos
#
# The pattern is `.env*` with an explicit exception, not the usual list
# (`.env`, `.env.local`, `.env.*.local`): that list misses `.env.production` and
# `.env.staging`, precisely the ones that would hold real secrets. A list has to be
# remembered and extended; a wildcard with an exception does not.
.env*
!.env.example

# tests
coverage/
playwright-report/
test-results/
blob-report/
e2e/.features-gen/

# Playwright CLI sessions: snapshots of the app's accessibility tree, one per command.
# They regenerate on their own and are not source.
#
# The previous rule said `.playwright-cache/`, which does not exist in this project and
# therefore covered nothing. This is the real directory, created at the root or inside
# `e2e/` depending on where it is invoked from.
.playwright-cli/

# supabase local
supabase/.temp/
supabase/.branches/

# turbo
.turbo/

# editores / SO
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Salida de herramienta, no fuente: mil nodos regenerables con `pnpm arch:graph`.
# El diagrama que se lee esta escrito a mano en el mismo directorio.
docs/diagrams/dependency-graph.generated.md

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# playwright-bdd genera estos specs a partir de los .feature
e2e/.features-gen/
