{
  "name": "corebiz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@corebiz/web",
    "dev:nodb": "cross-env DATA_DRIVER=memory turbo run dev --filter=@corebiz/web",
    "build": "turbo run build",
    "start": "turbo run start --filter=@corebiz/web",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,yaml,yml,css}\"",
    "typecheck": "turbo run typecheck",
    "arch": "depcruise --config .dependency-cruiser.cjs packages apps",
    "arch:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot packages apps | dot -T svg > docs/diagrams/dependency-graph.svg",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project domain --project application",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @corebiz/e2e test",
    "test:bdd": "pnpm --filter @corebiz/e2e test:bdd",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch && pnpm test:unit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:generate": "pnpm --filter @corebiz/db generate",
    "prepare": "lefthook install",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "lefthook": "^2.1.12",
    "prettier": "^3.6.2",
    "supabase": "^2.54.11",
    "turbo": "^2.5.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  }
}
