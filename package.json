{
  "name": "corebiz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@corebiz/web --filter=@corebiz/api",
    "dev:web": "turbo run dev --filter=@corebiz/web",
    "dev:api": "turbo run dev --filter=@corebiz/api",
    "build": "turbo run build",
    "start": "turbo run start --filter=@corebiz/web",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,yaml,yml,css}\"",
    "typecheck": "turbo run typecheck",
    "arch": "depcruise --config .dependency-cruiser.cjs packages apps",
    "arch:graph": "depcruise --config .dependency-cruiser.cjs --output-type mermaid packages apps > docs/diagrams/dependency-graph.generated.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project domain --project application --project api",
    "test:integration": "vitest run --project integration --project api-integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @corebiz/e2e test",
    "test:bdd": "pnpm --filter @corebiz/e2e test:bdd",
    "test:bdd:pg": "supabase db reset && cross-env E2E_DRIVER=postgres pnpm --filter @corebiz/e2e test:bdd",
    "test:e2e:pg": "supabase db reset && cross-env E2E_DRIVER=postgres pnpm --filter @corebiz/e2e exec playwright test",
    "approve": "supabase db reset && cross-env E2E_DRIVER=postgres pnpm --filter @corebiz/e2e exec playwright test specs/acceptance.spec.ts --reporter=list",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch && pnpm check:non-fiscal && pnpm check:prisma && pnpm test:unit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "prepare": "lefthook install || exit 0",
    "lint:fix": "eslint . --fix",
    "db:studio": "pnpm --filter @corebiz/db studio",
    "check:non-fiscal": "bash scripts/check-non-fiscal.sh",
    "db:pull": "pnpm --filter @corebiz/db db:pull",
    "db:generate": "pnpm --filter @corebiz/db db:generate",
    "check:prisma": "bash scripts/check-prisma-owns-nothing.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "lefthook": "^2.1.12",
    "prettier": "^3.6.2",
    "supabase": "^2.54.11",
    "turbo": "^2.5.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  }
}
